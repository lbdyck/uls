)ATTR
  @ AREA(DYNAMIC) SCROLL(ON) EXTEND(ON)
  01 TYPE(DATAOUT) COLOR(WHITE)
  02 TYPE(DATAOUT) COLOR(YELLOW)
  _  TYPE(INPUT) INTENS(LOW) HILITE(USCORE) CAPS(ON)
)BODY
%---------------- ULS - User List Services -------------------------------%
%Command ===>_ZCMD                                    %Scroll ===>_Z    +
+
+Data set level ===>_LEVEL                                       +
+Filter: &FILTER                  Sort: &SORTBY &SORTDIR
+Rows: &TOTAL displayed, &SHOWN on this page
+
+Act Row  Data set name                                Volume M Device
@DYNAREA,DYNSHAD                                                           @
+
 &STATUS
+
 Enter B/E/V/I in Act for Browse/Edit/View/Info. See HELP for commands.
)INIT
  IF (&ZSCROLLA = &Z) &ZSCROLLA = 'PAGE'
  .ZVARS = '(ZSCROLLA)'
  .HELP = ULSHELP
)PROC
  VER(&LEVEL,DSNAME)
  IF (&ZSCROLLA NE 'PAGE' AND &ZSCROLLA NE 'CSR')
    VER(&ZSCROLLA,NB,RANGE,1,99999)
)FIELD
  FIELD(LEVEL) LEN(44)
  FIELD(ZSCROLLA) LEN(5)
)END
